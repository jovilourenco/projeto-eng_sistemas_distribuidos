{
  "grupo": "grupo_09",
  "descricao": "Ticket Rush. Adaptador inicial gerado pelo kit: o grupo deve confirmar a URL, as rotas e os campos antes do teste.",
  "base_url": "http://localhost:8180/api",
  "cabecalhos": {},
  "cabecalho_idempotencia": "Idempotency-Key",
  "cabecalhos_teste": {
    "X-Chave-Teste": "kit-avaliacao"
  },
  "timeout_requisicao": "30s",
  "rotas": {
    "listar_assentos": {
      "metodo": "GET",
      "caminho": "/eventos/{evento_id}/assentos?setor={setor}",
      "campo_lista": "assentos",
      "campo_id": "assento_id",
      "campo_status": "status",
      "valores_disponivel": [
        "disponivel"
      ]
    },
    "reservar": {
      "metodo": "POST",
      "caminho": "/reservas",
      "corpo": {
        "evento_id": "{evento_id}",
        "usuario_id": "{usuario_id}",
        "assento_ids": "{assento_ids}"
      },
      "campo_reserva_id": "reserva_id",
      "codigos_sucesso": [
        200,
        201
      ],
      "codigos_conflito": [
        409
      ]
    },
    "pagar": {
      "metodo": "POST",
      "caminho": "/reservas/{reserva_id}/pagamento",
      "corpo": {
        "metodo": "pix",
        "simulacao": "{simulacao}"
      },
      "codigos_sucesso": [
        200
      ],
      "codigos_pendente": [
        202
      ],
      "codigos_recusa": [
        402
      ]
    },
    "consultar": {
      "metodo": "GET",
      "caminho": "/reservas/{reserva_id}",
      "campo_status": "status",
      "valores_status": {
        "confirmada": [
          "confirmada"
        ],
        "recusada": [
          "recusada",
          "cancelada"
        ],
        "expirada": [
          "expirada"
        ]
      }
    }
  },
  "caos": {
    "diretorio_compose": "",
    "servico_para_derrubar": ""
  },
  "pendencias_do_grupo": "Traefik em localhost:8180 com o Guard exigindo token do Keycloak (colocar 'Authorization: Bearer ...' em 'cabecalhos'). Compra em POST /api/orders; a SAGA é assíncrona (RESERVED → PAYING), então o pagamento deve responder 202 e 'valores_status' deve mapear os status do pedido (ex.: confirmada: ['PAID'], recusada: ['CANCELLED'], expirada: ['EXPIRED'])."
}